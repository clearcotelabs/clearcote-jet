# Copy to .env (gitignored) and fill in. Variables already set in your environment win.

# Decision model: picks every click / type / select / scroll. See README, "Requirements".
TYPESAFE_API_KEY=

# Optional: an OpenAI-compatible text model for typed values. Without it, typed values are picked from the
# goal's own words by the decision model.
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
TEXT_MODEL=

# Clearcote licence: CLEARCOTE_LICENSE_KEY here, or ~/.clearcote/license.key. Without one the open build runs.
